.playwright-cli/
.DS_Store

# Dependency directories should be restored from lockfiles on each machine.
node_modules/
**/node_modules/
.pnpm-store/
.npm/
.yarn/

# Backup of former nested repositories after monorepo migration.
projects/*/source/.git.backup-*/

# Keep local Python environments and runtime outputs out of the workspace repo.
.venv/
__pycache__/
*.pyc

# Local build and framework caches.
.next/
**/.next/
dist/
**/dist/
build/
**/build/
.cache/
**/.cache/
.turbo/
coverage/
.vite/

# Local logs.
*.log

# 本机凭据、登录资料和临时文件不进入公开仓库。
.env
.env.*
!.env.example
!.env.sample
!.env.template
auth.json
storage-state.json
storage_state.json
.browser-profiles/
*.pem
*.p12
*.pfx
*.tmp
*.pid
*.tar.gz
*.tgz

# 新增任务过程媒体默认留本机；当前资源按T15清单显式纳入。
# 已经跟踪的资产仍正常保留，不因此删除工作文件或历史提交。
projects/**/tasks/**/output/**/*.png
projects/**/tasks/**/output/**/*.jpg
projects/**/tasks/**/output/**/*.jpeg
projects/**/tasks/**/output/**/*.webp
projects/**/tasks/**/output/**/*.zip
**/assets-review/_archive/
