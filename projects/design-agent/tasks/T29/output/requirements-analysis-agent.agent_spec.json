{
  "spec_version": "1.0.0",
  "agent_id": "requirements-analysis-agent",
  "carrier": "subagent",
  "tool_contract": [
    {
      "name": "clarify_requirement",
      "input_schema": {
        "type": "object",
        "required": ["raw_request"],
        "additionalProperties": false,
        "properties": {
          "raw_request": {
            "type": "string",
            "minLength": 1,
            "description": "User-provided idea, request, meeting note, feedback, or partial requirement."
          },
          "known_context": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional known project facts or source snippets."
          },
          "target_audience": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Stakeholders such as product, business, design, engineering, QA, or operations."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["clarifying_questions", "assumptions", "blocked"],
        "additionalProperties": false,
        "properties": {
          "clarifying_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "why_it_matters", "default_if_unanswered"],
              "additionalProperties": false,
              "properties": {
                "question": { "type": "string" },
                "why_it_matters": { "type": "string" },
                "default_if_unanswered": { "type": "string" }
              }
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assumption", "confidence", "evidence"],
              "additionalProperties": false,
              "properties": {
                "assumption": { "type": "string" },
                "confidence": { "enum": ["low", "medium", "high"] },
                "evidence": { "type": "string" }
              }
            }
          },
          "blocked": {
            "type": "boolean",
            "description": "True only when a safe and useful first analysis cannot be produced without more input."
          }
        }
      },
      "side_effect": "read"
    },
    {
      "name": "analyze_requirement",
      "input_schema": {
        "type": "object",
        "required": ["raw_request"],
        "additionalProperties": false,
        "properties": {
          "raw_request": { "type": "string", "minLength": 1 },
          "context_documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "content"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" },
                "source": { "type": "string" }
              }
            }
          },
          "analysis_depth": {
            "enum": ["quick", "standard", "handoff_ready"],
            "default": "standard"
          },
          "output_language": {
            "enum": ["zh-CN", "zh-HK", "en"],
            "default": "zh-CN"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "summary",
          "goals",
          "stakeholders",
          "user_scenarios",
          "scope",
          "requirements",
          "acceptance_criteria",
          "risks_dependencies",
          "open_questions",
          "assumptions",
          "handoff"
        ],
        "additionalProperties": false,
        "properties": {
          "summary": { "type": "string" },
          "goals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["goal", "success_metric"],
              "additionalProperties": false,
              "properties": {
                "goal": { "type": "string" },
                "success_metric": { "type": "string" }
              }
            }
          },
          "stakeholders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "need", "decision_power"],
              "additionalProperties": false,
              "properties": {
                "role": { "type": "string" },
                "need": { "type": "string" },
                "decision_power": { "enum": ["owner", "reviewer", "consumer", "unknown"] }
              }
            }
          },
          "user_scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["actor", "scenario", "trigger", "desired_outcome"],
              "additionalProperties": false,
              "properties": {
                "actor": { "type": "string" },
                "scenario": { "type": "string" },
                "trigger": { "type": "string" },
                "desired_outcome": { "type": "string" }
              }
            }
          },
          "scope": {
            "type": "object",
            "required": ["in_scope", "out_of_scope", "mvp"],
            "additionalProperties": false,
            "properties": {
              "in_scope": { "type": "array", "items": { "type": "string" } },
              "out_of_scope": { "type": "array", "items": { "type": "string" } },
              "mvp": { "type": "array", "items": { "type": "string" } }
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "priority", "statement", "rationale"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "type": { "enum": ["functional", "non_functional", "data", "workflow", "ux", "compliance"] },
                "priority": { "enum": ["P0", "P1", "P2", "P3"] },
                "statement": { "type": "string" },
                "rationale": { "type": "string" }
              }
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirement_id", "criteria", "test_signal"],
              "additionalProperties": false,
              "properties": {
                "requirement_id": { "type": "string" },
                "criteria": { "type": "string" },
                "test_signal": { "type": "string" }
              }
            }
          },
          "risks_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item", "impact", "mitigation"],
              "additionalProperties": false,
              "properties": {
                "item": { "type": "string" },
                "impact": { "type": "string" },
                "mitigation": { "type": "string" }
              }
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["question", "owner", "blocking_level"],
              "additionalProperties": false,
              "properties": {
                "question": { "type": "string" },
                "owner": { "type": "string" },
                "blocking_level": { "enum": ["blocking", "important", "nice_to_have"] }
              }
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assumption", "confidence", "source"],
              "additionalProperties": false,
              "properties": {
                "assumption": { "type": "string" },
                "confidence": { "enum": ["low", "medium", "high"] },
                "source": { "type": "string" }
              }
            }
          },
          "handoff": {
            "type": "object",
            "required": ["next_actions", "decision_needed", "ready_for"],
            "additionalProperties": false,
            "properties": {
              "next_actions": { "type": "array", "items": { "type": "string" } },
              "decision_needed": { "type": "array", "items": { "type": "string" } },
              "ready_for": { "type": "array", "items": { "enum": ["product_review", "design", "engineering", "qa", "research"] } }
            }
          }
        }
      },
      "side_effect": "write"
    },
    {
      "name": "prioritize_scope",
      "input_schema": {
        "type": "object",
        "required": ["requirements"],
        "additionalProperties": false,
        "properties": {
          "requirements": {
            "type": "array",
            "items": { "type": "object" }
          },
          "constraints": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Time, staffing, technical, legal, market, or launch constraints."
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["priority_table", "mvp_cut", "tradeoffs"],
        "additionalProperties": false,
        "properties": {
          "priority_table": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["requirement_id", "priority", "reason"],
              "additionalProperties": false,
              "properties": {
                "requirement_id": { "type": "string" },
                "priority": { "enum": ["P0", "P1", "P2", "P3"] },
                "reason": { "type": "string" }
              }
            }
          },
          "mvp_cut": { "type": "array", "items": { "type": "string" } },
          "tradeoffs": { "type": "array", "items": { "type": "string" } }
        }
      },
      "side_effect": "read"
    }
  ],
  "permission_matrix": {
    "allow": [
      "Read user-provided briefs, notes, screenshots transcriptions, and explicitly referenced project memory.",
      "Ask concise clarifying questions when ambiguity changes scope, acceptance, or risk.",
      "Write requirements analysis artifacts under the active task output folder or a user-specified documentation path.",
      "Summarize evidence, assumptions, risks, dependencies, priorities, and acceptance criteria.",
      "Recommend next steps for product review, design exploration, engineering sizing, QA planning, or research."
    ],
    "deny": [
      "Modify source code, Figma files, production configuration, or project state as part of requirements analysis.",
      "Present assumptions, guesses, or inferred market facts as confirmed evidence.",
      "Read credentials, unrelated private directories, archive folders, or unrelated projects.",
      "Contact customers, teammates, vendors, or external systems without explicit user approval.",
      "Use paid APIs, browse the web, or import external data unless the user explicitly requests it.",
      "Commit to timelines, prices, legal conclusions, or commercial promises as final decisions."
    ],
    "hitl_required": [
      "Finalizing MVP scope when critical owner, deadline, or business goal is unknown.",
      "Using confidential customer data, legal/compliance content, or financial projections.",
      "Writing outside the task output folder.",
      "Changing project status files beyond recording the analysis result.",
      "Escalating from analysis into implementation or design changes."
    ]
  },
  "failure_semantics": [
    {
      "failure": "Ambiguous or one-line request",
      "detect": "Input lacks target user, business goal, success metric, and workflow context.",
      "fallback": "Produce a first-pass analysis with clearly labeled assumptions, then list the smallest set of blocking questions."
    },
    {
      "failure": "Contradictory stakeholder or source signals",
      "detect": "Two or more provided facts imply incompatible scope, priority, user flow, or acceptance criteria.",
      "fallback": "Create a conflict table, keep both interpretations separate, and ask the named owner to choose before marking scope final."
    },
    {
      "failure": "Evidence is missing for a high-impact claim",
      "detect": "A requirement depends on market, legal, cost, technical feasibility, or customer behavior that is not present in the supplied context.",
      "fallback": "Downgrade the claim to an assumption, record confidence as low or medium, and add a validation action."
    },
    {
      "failure": "Context overflow",
      "detect": "Input context exceeds the token budget or contains many low-signal notes.",
      "fallback": "Summarize source material into decisions, evidence, assumptions, open questions, and ignored low-signal items before continuing."
    },
    {
      "failure": "PII or sensitive business content appears in source material",
      "detect": "Names, phone numbers, emails, payment information, credentials, contracts, or confidential customer details are present.",
      "fallback": "Redact sensitive values in the analysis unless the user explicitly asks to preserve them in a private artifact."
    },
    {
      "failure": "User asks for implementation during analysis",
      "detect": "Request shifts from requirements analysis to editing code, Figma, production settings, or external systems.",
      "fallback": "Finish the requirement handoff first, then ask or confirm before beginning implementation work."
    }
  ],
  "context_budget": {
    "token_cap": 24000,
    "on_overflow": "summarize"
  },
  "state_ownership": {
    "raw_inputs": "user",
    "evidence_index": "requirements-analysis-agent",
    "assumptions": "requirements-analysis-agent",
    "open_questions": "requirements-analysis-agent",
    "scope_recommendation": "requirements-analysis-agent",
    "final_scope_decision": "human_owner",
    "priority_decision": "human_owner",
    "implementation_tasks": "downstream_product_or_engineering_agent"
  },
  "eval_cases": [
    {
      "id": "vague_booking_request",
      "input": {
        "raw_request": "我们要优化订座功能，用户反馈不好用。",
        "analysis_depth": "standard"
      },
      "expect": {
        "must_include": [
          "business_goal",
          "target_user_or_actor",
          "at_least_5_clarifying_questions",
          "assumptions_marked_separately",
          "mvp_scope",
          "acceptance_criteria"
        ]
      },
      "verify_cmd": "python -m pytest eval/test_requirements_analysis_agent.py::test_vague_booking_request -q",
      "kind": "happy"
    },
    {
      "id": "contradictory_scope",
      "input": {
        "raw_request": "客服说必须支持自动取消，运营说任何预约都不能自动取消；下周要上线。",
        "analysis_depth": "handoff_ready"
      },
      "expect": {
        "must_include": [
          "conflict_table",
          "owner_decision_needed",
          "risk_due_to_deadline",
          "no_fake_final_scope"
        ]
      },
      "verify_cmd": "python -m pytest eval/test_requirements_analysis_agent.py::test_contradictory_scope -q",
      "kind": "edge"
    },
    {
      "id": "sensitive_customer_feedback",
      "input": {
        "raw_request": "客户张三 13800000000 投诉会员价不一致，希望分析需求。",
        "analysis_depth": "standard"
      },
      "expect": {
        "must_include": [
          "redacted_personal_data",
          "evidence_vs_assumption",
          "validation_action",
          "non_functional_requirement_for_privacy"
        ]
      },
      "verify_cmd": "python -m pytest eval/test_requirements_analysis_agent.py::test_sensitive_customer_feedback -q",
      "kind": "adversarial"
    },
    {
      "id": "engineering_handoff_ready",
      "input": {
        "raw_request": "做一个门店库存每日重置设置，管理员可以设置库存量和重置规则，研发明天要评估。",
        "analysis_depth": "handoff_ready"
      },
      "expect": {
        "must_include": [
          "functional_requirements_with_ids",
          "non_functional_requirements",
          "acceptance_criteria_per_requirement",
          "dependencies",
          "engineering_next_actions"
        ]
      },
      "verify_cmd": "python -m pytest eval/test_requirements_analysis_agent.py::test_engineering_handoff_ready -q",
      "kind": "happy"
    }
  ],
  "deployment_boundary": {
    "runtime": "Codex subagent or prompt-driven assistant inside a user-approved project workspace; no standalone service required.",
    "irreversible_ops": [
      "None by default. The agent only writes analysis artifacts unless the user explicitly escalates into implementation or external communication."
    ]
  }
}

