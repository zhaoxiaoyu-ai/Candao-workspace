{
  "spec_version": "1.0.0",
  "agent_id": "web-competitor-style-analyst-v2",
  "carrier": "subagent",
  "tool_contract": [
    {
      "name": "classify_analysis_goal",
      "input_schema": {
        "type": "object",
        "required": ["user_goal"],
        "additionalProperties": false,
        "properties": {
          "user_goal": {
            "type": "string",
            "description": "用户本次分析目标，例如视觉分析、交互分析、功能分析或综合分析。"
          },
          "requested_modes": {
            "type": "array",
            "items": {
              "enum": ["visual", "interaction", "function", "comprehensive"]
            }
          },
          "target_consumer": {
            "enum": ["designer", "web_generation_agent", "both"]
          },
          "target_page_context": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["analysis_modes", "output_contract", "need_clarification", "terminology_policy"],
        "additionalProperties": false,
        "properties": {
          "analysis_modes": {
            "type": "array",
            "items": {
              "enum": ["visual", "interaction", "function", "comprehensive"]
            }
          },
          "output_contract": {
            "type": "object",
            "required": ["designer_sections", "generator_brief_sections", "score_dimensions"],
            "additionalProperties": false,
            "properties": {
              "designer_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "generator_brief_sections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "score_dimensions": {
                "type": "array",
                "items": {
                  "enum": ["visual", "structure", "copy", "interaction", "compliance"]
                }
              }
            }
          },
          "need_clarification": {
            "type": "boolean"
          },
          "clarification_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminology_policy": {
            "type": "string",
            "description": "默认中文解释专业术语；仅字段名、命令、URL、第三方名词等技术必要内容保留英文。"
          }
        }
      },
      "side_effect": "read"
    },
    {
      "name": "collect_public_page_evidence",
      "input_schema": {
        "type": "object",
        "required": ["reference_urls", "viewports"],
        "additionalProperties": false,
        "properties": {
          "reference_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "viewports": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["name", "width", "height"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              }
            }
          },
          "capture_interactions": {
            "type": "boolean"
          },
          "include_dom_text": {
            "type": "boolean"
          },
          "include_asset_manifest": {
            "type": "boolean"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["pages", "evidence_limitations"],
        "additionalProperties": false,
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "final_url", "status", "title", "language", "section_outline", "screenshots", "capture_confidence"],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "final_url": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "section_outline": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "nav_labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cta_labels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "screenshots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["viewport", "path", "width", "height", "sha256"],
                    "additionalProperties": false,
                    "properties": {
                      "viewport": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "width": {
                        "type": "integer"
                      },
                      "height": {
                        "type": "integer"
                      },
                      "sha256": {
                        "type": "string"
                      }
                    }
                  }
                },
                "interaction_notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "asset_manifest": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "capture_confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "evidence_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "side_effect": "external"
    },
    {
      "name": "extract_mode_patterns",
      "input_schema": {
        "type": "object",
        "required": ["page_evidence", "analysis_modes"],
        "additionalProperties": false,
        "properties": {
          "page_evidence": {
            "type": "object"
          },
          "analysis_modes": {
            "type": "array",
            "items": {
              "enum": ["visual", "interaction", "function", "comprehensive"]
            }
          },
          "designer_readability": {
            "type": "boolean"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["visual_patterns", "interaction_patterns", "function_patterns", "copy_patterns", "confidence"],
        "additionalProperties": false,
        "properties": {
          "visual_patterns": {
            "type": "object",
            "required": ["tone_keywords", "palette", "typography", "layout_density", "imagery", "component_shape", "designer_key_description"],
            "additionalProperties": false,
            "properties": {
              "tone_keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "typography": {
                "type": "object"
              },
              "layout_density": {
                "type": "object"
              },
              "imagery": {
                "type": "object"
              },
              "component_shape": {
                "type": "object"
              },
              "designer_key_description": {
                "type": "string"
              }
            }
          },
          "interaction_patterns": {
            "type": "object",
            "required": ["navigation", "cta_behavior", "scroll_rhythm", "feedback", "forms_or_filters", "generator_key_description"],
            "additionalProperties": false,
            "properties": {
              "navigation": {
                "type": "object"
              },
              "cta_behavior": {
                "type": "object"
              },
              "scroll_rhythm": {
                "type": "object"
              },
              "feedback": {
                "type": "object"
              },
              "forms_or_filters": {
                "type": "object"
              },
              "generator_key_description": {
                "type": "string"
              }
            }
          },
          "function_patterns": {
            "type": "object",
            "required": ["module_inventory", "business_capabilities", "data_fields", "task_flow", "generator_key_description"],
            "additionalProperties": false,
            "properties": {
              "module_inventory": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "business_capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "data_fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "task_flow": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "generator_key_description": {
                "type": "string"
              }
            }
          },
          "copy_patterns": {
            "type": "object",
            "required": ["voice", "headline_rhythm", "cta_language", "trust_language"],
            "additionalProperties": false,
            "properties": {
              "voice": {
                "type": "string"
              },
              "headline_rhythm": {
                "type": "string"
              },
              "cta_language": {
                "type": "string"
              },
              "trust_language": {
                "type": "string"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "side_effect": "read"
    },
    {
      "name": "synthesize_commonality_and_blend",
      "input_schema": {
        "type": "object",
        "required": ["competitor_profiles", "fusion_policy"],
        "additionalProperties": false,
        "properties": {
          "competitor_profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "fusion_policy": {
            "type": "object",
            "required": ["use_commonality_as_main_reference", "allow_selected_visual_excellence", "allow_selected_interaction_excellence"],
            "additionalProperties": false,
            "properties": {
              "use_commonality_as_main_reference": {
                "type": "boolean"
              },
              "allow_selected_visual_excellence": {
                "type": "boolean"
              },
              "allow_selected_interaction_excellence": {
                "type": "boolean"
              },
              "primary_reference_url": {
                "type": ["string", "null"]
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["commonality_core", "selected_visual_blends", "selected_interaction_blends", "function_reference", "conflict_matrix", "source_trace", "blend_decision"],
        "additionalProperties": false,
        "properties": {
          "commonality_core": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected_visual_blends": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_url", "pattern", "why_useful", "safe_adaptation"],
              "additionalProperties": false,
              "properties": {
                "source_url": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "why_useful": {
                  "type": "string"
                },
                "safe_adaptation": {
                  "type": "string"
                }
              }
            }
          },
          "selected_interaction_blends": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_url", "pattern", "why_useful", "safe_adaptation"],
              "additionalProperties": false,
              "properties": {
                "source_url": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                },
                "why_useful": {
                  "type": "string"
                },
                "safe_adaptation": {
                  "type": "string"
                }
              }
            }
          },
          "function_reference": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "conflict_matrix": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "blend_decision": {
            "type": "string"
          }
        }
      },
      "side_effect": "read"
    },
    {
      "name": "write_mode_based_brief",
      "input_schema": {
        "type": "object",
        "required": ["analysis_modes", "synthesis", "target_consumer", "style_fit_thresholds"],
        "additionalProperties": false,
        "properties": {
          "analysis_modes": {
            "type": "array",
            "items": {
              "enum": ["visual", "interaction", "function", "comprehensive"]
            }
          },
          "synthesis": {
            "type": "object"
          },
          "target_consumer": {
            "enum": ["designer", "web_generation_agent", "both"]
          },
          "target_page_context": {
            "type": "string"
          },
          "style_fit_thresholds": {
            "type": "object",
            "required": ["overall", "visual", "structure", "copy", "interaction", "compliance"],
            "additionalProperties": false,
            "properties": {
              "overall": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "visual": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "structure": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "copy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interaction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "compliance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["designer_report_md", "generator_brief", "prompt_blocks", "qa_checklist", "glossary", "compliance_boundary"],
        "additionalProperties": false,
        "properties": {
          "designer_report_md": {
            "type": "string"
          },
          "generator_brief": {
            "type": "object",
            "required": ["analysis_modes", "commonality_core", "visual_key_brief", "interaction_key_brief", "function_key_brief", "page_structure", "token_guidance", "component_rules", "copy_rules", "forbidden_copy_items", "acceptance_scores"],
            "additionalProperties": false,
            "properties": {
              "analysis_modes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "commonality_core": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "visual_key_brief": {
                "type": "object"
              },
              "interaction_key_brief": {
                "type": "object"
              },
              "function_key_brief": {
                "type": "object"
              },
              "page_structure": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "token_guidance": {
                "type": "object"
              },
              "component_rules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "copy_rules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbidden_copy_items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptance_scores": {
                "type": "object"
              }
            }
          },
          "prompt_blocks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "qa_checklist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "glossary": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "compliance_boundary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "side_effect": "write"
    },
    {
      "name": "score_style_fit",
      "input_schema": {
        "type": "object",
        "required": ["reference_package", "generated_page_evidence"],
        "additionalProperties": false,
        "properties": {
          "reference_package": {
            "type": "object"
          },
          "generated_page_evidence": {
            "type": "object"
          },
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "visual": {
                "type": "number"
              },
              "structure": {
                "type": "number"
              },
              "copy": {
                "type": "number"
              },
              "interaction": {
                "type": "number"
              },
              "compliance": {
                "type": "number"
              }
            }
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["overall_score", "dimension_scores", "pass", "blocking_reasons", "remediation_plan"],
        "additionalProperties": false,
        "properties": {
          "overall_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dimension_scores": {
            "type": "object",
            "required": ["visual", "structure", "copy", "interaction", "compliance"],
            "additionalProperties": false,
            "properties": {
              "visual": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "structure": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "copy": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "interaction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "compliance": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "pass": {
            "type": "boolean",
            "description": "只有 overall_score >= 0.82 且 compliance = 1.0 时才能为 true。"
          },
          "blocking_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remediation_plan": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "side_effect": "read"
    }
  ],
  "permission_matrix": {
    "allow": [
      "读取用户提供的公开网页 URL",
      "抓取公开页面 DOM 文本、标题、导航、CTA 和页面结构",
      "截取桌面、平板、移动端响应式截图",
      "分析公开页面的视觉、交互、功能和文案模式",
      "输出中文设计师报告、网页生成 Agent brief、评分表和合规边界"
    ],
    "deny": [
      "登录或绕过私有页面、付费墙、验证码和访问限制",
      "复制竞品 logo、图片、视频、源码、完整布局文件或独特品牌资产",
      "近似复写竞品原文、标题、CTA 文案或专有命名",
      "把截图推断伪装成已验证 DOM 事实",
      "在证据不足时声称已经达到风格贴合"
    ],
    "hitl_required": [
      "用户要求完全克隆或复刻竞品时必须转为安全抽象方案",
      "多个竞品气质冲突且无法用共性归纳时，必须让用户确认主参考或融合权重",
      "公开页面抓取失败、截图缺失、关键动效无法观察时，必须标注置信度并请求补充截图或允许重试"
    ]
  },
  "failure_semantics": [
    {
      "failure": "analysis_goal_unclear",
      "detect": "用户没有说明本次要分析视觉、交互、功能还是综合，且目标会影响输出结构。",
      "fallback": "默认使用综合分析，但在报告开头标注假设；同时给出 1 到 3 个澄清问题，方便用户下一轮收窄。"
    },
    {
      "failure": "public_page_capture_failed",
      "detect": "URL 无法访问、状态码非 2xx、页面依赖登录、截图缺失或 DOM 文本为空。",
      "fallback": "保留可获得证据，降低 capture_confidence，不输出硬性风格结论；请求用户提供截图、替代 URL 或允许重新抓取。"
    },
    {
      "failure": "dynamic_content_not_observed",
      "detect": "滚动、hover、筛选、搜索、动效或懒加载内容无法通过静态截图验证。",
      "fallback": "把相关判断标记为交互假设，只输出可安全复用的交互方向，并要求补充录屏或人工确认。"
    },
    {
      "failure": "multi_competitor_conflict",
      "detect": "多个竞品在色彩、密度、叙事节奏、结构或转化路径上明显冲突。",
      "fallback": "输出 conflict_matrix；共性仍作为主参考，优秀视觉与交互单独列为可选融合项，并保留来源 URL 和取舍理由。"
    },
    {
      "failure": "style_fit_below_threshold",
      "detect": "overall_score < 0.82，或 visual、structure、copy、interaction 任一关键分数明显低于目标。",
      "fallback": "输出 blocking_reasons 和 remediation_plan，按视觉、结构、文案、交互拆分修正建议，不允许标记为通过。"
    },
    {
      "failure": "compliance_violation",
      "detect": "发现竞品 logo、原图、视频、源码、近似原文、独特品牌资产或可识别专有元素被复制。",
      "fallback": "compliance 分数降为 0，pass 必须为 false；删除或替换侵权风险内容，只保留抽象风格原则。"
    }
  ],
  "context_budget": {
    "token_cap": 48000,
    "on_overflow": "spill_to_file"
  },
  "state_ownership": {
    "analysis_goal": "classify_analysis_goal",
    "page_evidence": "collect_public_page_evidence",
    "visual_patterns": "extract_mode_patterns",
    "interaction_patterns": "extract_mode_patterns",
    "function_patterns": "extract_mode_patterns",
    "commonality_core": "synthesize_commonality_and_blend",
    "blend_decision": "synthesize_commonality_and_blend",
    "designer_report_md": "write_mode_based_brief",
    "generator_brief": "write_mode_based_brief",
    "style_fit_report": "score_style_fit"
  },
  "eval_cases": [
    {
      "id": "visual_mode_designer_brief_aigens",
      "kind": "happy",
      "input": {
        "reference_urls": ["https://www.aigens.com/kiosk-ordering/"],
        "analysis_modes": ["visual"],
        "target_consumer": "designer",
        "target_page_context": "餐饮自助点餐设备产品页"
      },
      "expect": {
        "must_output": [
          "中文视觉共性摘要",
          "visual_key_brief",
          "色彩、字体、版式、留白、图片/视频风格、组件形态",
          "首次出现 style-fit、token、CTA 时给出中文解释",
          "不输出完整功能分析"
        ],
        "minimum_scores": {
          "overall_score": 0.82,
          "visual": 0.8,
          "structure": 0.78,
          "copy": 0.78,
          "interaction": 0.74,
